#:mute

#:include 'common.fypp'

#:set DOC_ARGUMENT_N = 'degree of the target Legendre polynomial'

#:set DOC_ARGUMENT_K_L1 = 'selector of the target zero interval,'
#:set DOC_ARGUMENT_K_L2 = 'numbered in ascending order of `x`'

#:endmute
module ${MODULE_NAME}$

  use, intrinsic :: iso_fortran_env, only: int32
  #:for REAL_KIND in REAL_KINDS
  use, intrinsic :: iso_fortran_env, only: real${REAL_KIND}$
  #:endfor

  use, intrinsic :: ieee_arithmetic, only: ieee_signaling_nan
  use, intrinsic :: ieee_arithmetic, only: ieee_value



  implicit none



  private

  public :: ${GET_ZERO_INTERVAL_INTERFACE}$
  public :: ${GET_ZERO_INTERVAL_LOWER_INTERFACE}$
  public :: ${GET_ZERO_INTERVAL_UPPER_INTERFACE}$



  #:for REAL_KIND in REAL_KINDS
  real(real${REAL_KIND}$), parameter :: pi_real${REAL_KIND}$ = 3.141592653589793238462643383279502884197_real${REAL_KIND}$
  #:endfor



  !> version: experimental
  !! calculate
  !! \( ${WHAT_TO_RETURN_ZERO_INTERVAL_LOWER}$ \) and
  !! \( ${WHAT_TO_RETURN_ZERO_INTERVAL_UPPER}$ \)
  #:if defined("WITH_REAL128")
  !! for `real32`, `real64` and `real128`
  #:else
  !! for `real32` and `real64`
  #:endif
  interface ${GET_ZERO_INTERVAL_INTERFACE}$
    #:for REAL_KIND in REAL_KINDS
    module procedure ${GET_ZERO_INTERVAL_SUBROUTINE(REAL_KIND)}$
    #:endfor
  end interface

  !> version: experimental
  !! calculate \( ${WHAT_TO_RETURN_ZERO_INTERVAL_LOWER}$ \)
  #:if defined("WITH_REAL128")
  !! for `real32`, `real64` and `real128`
  #:else
  !! for `real32` and `real64`
  #:endif
  interface ${GET_ZERO_INTERVAL_LOWER_INTERFACE}$
    #:for REAL_KIND in REAL_KINDS
    module procedure ${GET_ZERO_INTERVAL_LOWER_SUBROUTINE(REAL_KIND)}$
    #:endfor
  end interface

  !> version: experimental
  !! calculate \( ${WHAT_TO_RETURN_ZERO_INTERVAL_UPPER}$ \)
  #:if defined("WITH_REAL128")
  !! for `real32`, `real64` and `real128`
  #:else
  !! for `real32` and `real64`
  #:endif
  interface ${GET_ZERO_INTERVAL_UPPER_INTERFACE}$
    #:for REAL_KIND in REAL_KINDS
    module procedure ${GET_ZERO_INTERVAL_UPPER_SUBROUTINE(REAL_KIND)}$
    #:endfor
  end interface



  contains


  #:for REAL_KIND in REAL_KINDS

  #:set SUBROUTINE_NAME = GET_ZERO_INTERVAL_SUBROUTINE(REAL_KIND)
  elemental subroutine ${SUBROUTINE_NAME}$(n, k, x_lower, x_upper)
    !! version: experimental
    !! calculate
    !! \( ${WHAT_TO_RETURN_ZERO_INTERVAL_LOWER}$ \) and
    !! \( ${WHAT_TO_RETURN_ZERO_INTERVAL_UPPER}$ \)
    !! for `real${REAL_KIND}$`
    !! @note
    !! signaling NaN is returned unless `${MINVAL_INTERVAL_INDEX}$ <= k <= n`.
    !! @endnote

    integer(int32), intent(in) :: n
      !! ${DOC_ARGUMENT_N}$

    integer(int32), intent(in) :: k
      !! ${DOC_ARGUMENT_K_L1}$
      !! ${DOC_ARGUMENT_K_L2}$

    real(real${REAL_KIND}$), intent(out) :: x_lower
      !! \( ${WHAT_TO_RETURN_ZERO_INTERVAL_LOWER}$ \)

    real(real${REAL_KIND}$), intent(out) :: x_upper
      !! \( ${WHAT_TO_RETURN_ZERO_INTERVAL_UPPER}$ \)


    call ${GET_ZERO_INTERVAL_LOWER_INTERFACE}$( n = n, k = k, x = x_lower )
    call ${GET_ZERO_INTERVAL_UPPER_INTERFACE}$( n = n, k = k, x = x_upper )

  end subroutine ${SUBROUTINE_NAME}$

  #:endfor
  #! REAL_KIND


  #:for REAL_KIND in REAL_KINDS

  #:set SUBROUTINE_NAME = GET_ZERO_INTERVAL_LOWER_SUBROUTINE(REAL_KIND)
  elemental subroutine ${SUBROUTINE_NAME}$(n, k, x)
    !! version: experimental
    !! calculate \( ${WHAT_TO_RETURN_ZERO_INTERVAL_LOWER}$ \) for `real${REAL_KIND}$`
    !! @note
    !! signaling NaN is returned unless `${MINVAL_INTERVAL_INDEX}$ <= k <= n`.
    !! @endnote

    integer(int32), intent(in) :: n
      !! ${DOC_ARGUMENT_N}$

    integer(int32), intent(in) :: k
      !! ${DOC_ARGUMENT_K_L1}$
      !! ${DOC_ARGUMENT_K_L2}$

    real(real${REAL_KIND}$), intent(out) :: x
      !! \( ${WHAT_TO_RETURN_ZERO_INTERVAL_LOWER}$ \)


    if ( (${MINVAL_INTERVAL_INDEX}$_int32 <= k) .and. (k <= n) ) then
      x = - cos( (k - 0.5_real${REAL_KIND}$) * pi_real${REAL_KIND}$ / (n + 0.5_real${REAL_KIND}$) )
    else
      x = ieee_value(0.0_real${REAL_KIND}$, ieee_signaling_nan)
    end if

  end subroutine ${SUBROUTINE_NAME}$

  #:endfor
  #! REAL_KIND


  #:for REAL_KIND in REAL_KINDS

  #:set SUBROUTINE_NAME = GET_ZERO_INTERVAL_UPPER_SUBROUTINE(REAL_KIND)
  elemental subroutine ${SUBROUTINE_NAME}$(n, k, x)
    !! version: experimental
    !! calculate \( ${WHAT_TO_RETURN_ZERO_INTERVAL_UPPER}$ \) for `real${REAL_KIND}$`
    !! @note
    !! signaling NaN is returned unless `1 <= k <= n`.
    !! @endnote

    integer(int32), intent(in) :: n
      !! ${DOC_ARGUMENT_N}$

    integer(int32), intent(in) :: k
      !! ${DOC_ARGUMENT_K_L1}$
      !! ${DOC_ARGUMENT_K_L2}$

    real(real${REAL_KIND}$), intent(out) :: x
      !! \( ${WHAT_TO_RETURN_ZERO_INTERVAL_UPPER}$ \)


    if ( (${MINVAL_INTERVAL_INDEX}$_int32 <= k) .and. (k <= n) ) then
      x = - cos( (k * pi_real${REAL_KIND}$) / (n + 0.5_real${REAL_KIND}$) )
    else
      x = ieee_value(0.0_real${REAL_KIND}$, ieee_signaling_nan)
    end if

  end subroutine ${SUBROUTINE_NAME}$

  #:endfor
  #! REAL_KIND
end module ${MODULE_NAME}$
