#:mute

#:set MODULE_NAME = 'legendre_polynomial_zero_intervals_fortran'

#:if defined('WITH_REAL128')
  #:set REAL_KINDS = [32, 64, 128]
#:else
  #:set REAL_KINDS = [32, 64]
#:endif

#:set GET_ZERO_INTERVAL_INTERFACE       = 'get_zero_interval'
#:set GET_ZERO_INTERVAL_LOWER_INTERFACE = 'get_zero_interval_lower'
#:set GET_ZERO_INTERVAL_UPPER_INTERFACE = 'get_zero_interval_upper'

#:def GET_ZERO_INTERVAL_SUBROUTINE(real_kind)
${GET_ZERO_INTERVAL_INTERFACE}$_real${real_kind}$
#:enddef

#:def GET_ZERO_INTERVAL_LOWER_SUBROUTINE(real_kind)
${GET_ZERO_INTERVAL_LOWER_INTERFACE}$_real${real_kind}$
#:enddef

#:def GET_ZERO_INTERVAL_UPPER_SUBROUTINE(real_kind)
${GET_ZERO_INTERVAL_UPPER_INTERFACE}$_real${real_kind}$
#:enddef

#:set MINVAL_DEGREE = 1

#! must match the indexing assumed in WHAT_TO_RETURN_ZERO_INTERVAL_*
#:set MINVAL_INTERVAL_INDEX = 1

#:set DOC_ARGUMENT_K_VALID_RANGE = str(MINVAL_INTERVAL_INDEX) + ' <= k <= n'

#:set WHAT_TO_RETURN_ZERO_INTERVAL_LOWER = r'- \cos \lbrace (k - \tfrac{1}{2}) \pi / (n + \tfrac{1}{2}) \rbrace'
#:set WHAT_TO_RETURN_ZERO_INTERVAL_UPPER = r'- \cos \lbrace k \pi / (n + \tfrac{1}{2}) \rbrace'

#:endmute
